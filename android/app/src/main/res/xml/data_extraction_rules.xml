<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- No user data leaves the device via backup; everything lives in Firebase. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
