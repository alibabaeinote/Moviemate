        "accent": {
          "$type": "color",
          "$value": "{ref.palette.blue.wash-dark}",
          "$description": "Tinted container, e.g. the active nav pill.",
          "$usage": "Active bottom-nav pill; the 'waiting on partner' strip."
        },
        "warning": {
          "$type": "color",
          "$value": "{ref.palette.amber.ground}",
          "$description": "An outstanding task the user still owes.",
          "$usage": "A Watchlist row in 'Waiting on you' — an outstanding task."
        }
      },
      "border": {
        "hairline": {
          "$type": "color",
          "$value": "{ref.palette.ink.3}",
          "$usage": "Card outlines, nav bar edge, divider between stat cells."
