      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{ref.palette.ink.900}",
          "$on": "{sys.light.surface.ground}",
          "$usage": "Film titles, headlines, body copy, stat numbers that are not accented."
        },
        "secondary": {
          "$type": "color",
          "$value": "{ref.palette.ink.500}",
          "$on": "{sys.light.surface.ground}",
          "$usage": "Meta lines: '2021 · Sci-Fi', 'Sara added this', nav labels when inactive."
        },
        "accent": {
          "$type": "color",
          "$value": "{ref.palette.blue.600}",
          "$on": "{sys.light.surface.ground}",
