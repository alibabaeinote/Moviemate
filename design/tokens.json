      },
      "pill": {
        "$type": "dimension",
        "$value": "999px"
      }
    },
    "font": {
      "family": {
        "display": {
          "$type": "fontFamily",
          "$value": [
            "Big Shoulders Display",
            "Arial Narrow",
            "sans-serif"
          ],
          "$description": "Headlines, film titles, stat numbers. Nothing else. Drawn condensed rather than squeezed, which is why it survives at small sizes where Anton did not."
        },
        "body": {
          "$type": "fontFamily",
          "$value": [
            "Inter",
            "system-ui",
            "sans-serif"
          ],
          "$description": "Everything else, button labels included."
        }
      },
      "weight": {
        "regular": {
          "$type": "fontWeight",
          "$value": 400
        },
        "medium": {
          "$type": "fontWeight",
          "$value": 500
        },
        "semibold": {
          "$type": "fontWeight",
          "$value": 600
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700
        },
        "extrabold": {
          "$type": "fontWeight",
          "$value": 800
        },
        "black": {
          "$type": "fontWeight",
          "$value": 900
        }
      },
      "size": {
        "10": {
          "$type": "dimension",
          "$value": "10.5px"
