          "$type": "dimension",
          "$value": "24px"
        },
        "80": {
          "$type": "dimension",
          "$value": "30px"
        },
        "90": {
          "$type": "dimension",
          "$value": "34px"
        },
        "100": {
          "$type": "dimension",
          "$value": "44px"
        },
        "110": {
          "$type": "dimension",
          "$value": "54px"
        }
      }
    },
    "opacity": {
      "grain": {
        "$type": "number",
        "$value": 0.04,
        "$description": "Film grain. 3-5% reads as warmth; 20% reads as a 2014 filter."
      },
      "disabled": {
        "$type": "number",
        "$value": 0.4
      },
      "pressWash": {
        "$type": "number",
        "$value": 0.06
      }
    },
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "120ms"
      },
      "quick": {
        "$type": "duration",
        "$value": "160ms"
      },
      "settle": {
        "$type": "duration",
        "$value": "280ms",
        "$description": "Ceiling. Every micro-interaction stays under 300ms."
      }
    },
    "scale": {
      "press": {
        "$type": "number",
        "$value": 0.97
      }
    },
    "ratio": {
      "posterHero": {
        "$type": "string",
        "$value": "4:5",
        "$description": "Match card. Portrait, because film posters are portrait."
      },
      "posterThumb": {
        "$type": "string",
        "$value": "2:3",
        "$description": "List thumbnail — the true poster ratio."
      },
      "still": {
        "$type": "string",
        "$value": "16:10",
        "$description": "Landscape stills only. Was wrongly applied to posters in v8; see §9 changelog."
      }
    },
    "border": {
      "$description": "Stroke widths. Colour is a separate semantic role; this is only thickness.",
      "hairline": {
        "$type": "dimension",
        "$value": "1dp",
        "$description": "Dividers, card outlines."
      },
      "thin": {
        "$type": "dimension",
        "$value": "1.5dp",
        "$description": "Input fields."
      },
      "thick": {
        "$type": "dimension",
        "$value": "2.5dp",
        "$description": "Avatar ring, commit ring."
      },
      "focus": {
        "$type": "dimension",
        "$value": "2dp",
        "$description": "Focus indicator."
      }
    },
    "breakpoint": {
      "$description": "Material 3 window size classes — the Android standard, so the app agrees with the platform rather than inventing its own.",
      "compact": {
        "$type": "dimension",
        "$value": "0dp",
        "$description": "Phone portrait. The only class v1 ships."
      },
      "medium": {
        "$type": "dimension",
        "$value": "600dp",
        "$description": "Unfolded foldable, tablet portrait."
      },
      "expanded": {
        "$type": "dimension",
        "$value": "840dp",
        "$description": "Tablet landscape, desktop."
      }
    },
    "grid": {
      "$description": "Layout grid, distinct from the 4px spacing base. Columns per window class.",
      "base": {
        "$type": "dimension",
        "$value": "4dp",
        "$description": "Every spacing value is a multiple of this."
      },
      "columnsCompact": {
        "$type": "number",
        "$value": 4
      },
      "columnsMedium": {
        "$type": "number",
        "$value": 8
      },
      "columnsExpanded": {
        "$type": "number",
        "$value": 12
      },
      "gutterCompact": {
        "$type": "dimension",
        "$value": "16dp"
      },
      "gutterMedium": {
        "$type": "dimension",
        "$value": "24dp"
      },
      "gutterExpanded": {
        "$type": "dimension",
        "$value": "24dp"
      }
    },
    "elevation": {
      "$description": "On a dark UI, depth reads through surface lightness more than shadow — a black shadow on a near-black ground is invisible. Each level therefore pairs a surface token with a shadow that stays subtle.",
      "level0": {
        "$type": "dimension",
        "$value": "0dp",
        "$description": "Flush with the ground."
      },
      "level1": {
        "$type": "dimension",
        "$value": "1dp",
        "$description": "Card, list row. Reads via surface.raised, not shadow."
      },
      "level2": {
        "$type": "dimension",
        "$value": "8dp",
        "$description": "Bottom sheet, menu."
      },
      "level3": {
        "$type": "dimension",
        "$value": "16dp",
        "$description": "Floating bottom nav, dialog."
      }
    },
    "icon": {
      "$description": "Line icons on a 24x24 grid, stroke 1.75-2dp, round caps and joins. Emoji is never a UI icon — only an optional post-watch reaction.",
      "sizeSm": {
        "$type": "dimension",
        "$value": "16dp",
        "$description": "Inline with meta text."
      },
      "sizeMd": {
        "$type": "dimension",
        "$value": "21dp",
        "$description": "Bottom nav."
      },
      "sizeLg": {
        "$type": "dimension",
        "$value": "24dp",
        "$description": "Default. Matches the design grid."
      },
      "sizeXl": {
        "$type": "dimension",
        "$value": "32dp",
        "$description": "Empty-state and feature marks."
      },
      "strokeThin": {
        "$type": "dimension",
        "$value": "1.75dp"
      },
      "stroke": {
        "$type": "dimension",
        "$value": "2dp"
      }
    },
    "easing": {
      "$description": "Cubic-bezier curves. Nothing in the app uses linear — it reads mechanical.",
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Default for state changes."
      },
      "decelerate": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          0,
          1
        ],
        "$description": "Elements entering the screen."
      },
      "accelerate": {
        "$type": "cubicBezier",
        "$value": [
          0.3,
          0,
          1,
          1
        ],
        "$description": "Elements leaving the screen."
      },
      "emphasized": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1.0
        ],
        "$description": "The commit confirmation — the one moment that should feel deliberate."
      }
    },
    "density": {
      "$description": "Row heights. Comfortable is the default; compact is only for a long Watched list where scanning beats breathing room.",
      "rowComfortable": {
        "$type": "dimension",
        "$value": "72dp"
      },
      "rowCompact": {
        "$type": "dimension",
        "$value": "56dp"
      },
      "touchMin": {
        "$type": "dimension",
        "$value": "48dp",
        "$description": "Never smaller, whatever the density."
      }
    }
  },
  "sys": {
    "$description": "TIER 2 — Semantic roles. This is the only tier a screen or component may read. Each role is defined per theme. Adding a role is how the system grows; a component needing a colour that has no role here means a role is missing, not that a primitive should be used directly.",
    "dark": {
      "$description": "Default theme. Film posters are composed for dark surrounds.",
      "surface": {
        "ground": {
          "$type": "color",
          "$value": "{ref.palette.ink.0}",
          "$description": "App background.",
          "$usage": "App background on every screen. The scaffold behind everything."
        },
        "raised": {
          "$type": "color",
          "$value": "{ref.palette.ink.1}",
          "$description": "Cards, sheets, list rows.",
          "$usage": "Cards, list rows, sheets, the bottom nav bar."
        },
        "sunken": {
          "$type": "color",
          "$value": "{ref.palette.ink.2}",
          "$description": "Track backgrounds, pressed insets.",
