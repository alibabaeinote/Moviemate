{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "MovieMate design tokens — single source of truth. Format: W3C Design Tokens Community Group draft. Tier rules and naming convention are documented in docs/MovieMate-Design-System.md §2. Validate any change with `node design/validate-tokens.mjs`.",
  "meta": {
    "version": {
      "$type": "string",
      "$value": "9.0.0"
    },
    "updated": {
      "$type": "string",
      "$value": "2026-09-04"
    },
    "defaultTheme": {
      "$type": "string",
      "$value": "dark"
    }
  },
  "ref": {
    "$description": "TIER 1 — Primitives. Raw values with neutral, factual names. Never referenced by a component; only semantic tokens may point here. Adding a primitive is cheap; renaming one is a breaking change.",
    "palette": {
      "ink": {
        "0": {
          "$type": "color",
          "$value": "#0F0F12",
          "$description": "Deepest ground. Slightly cool so the blue accent sits naturally on it."
        },
        "1": {
          "$type": "color",
          "$value": "#17171B"
        },
        "2": {
          "$type": "color",
          "$value": "#1F1F25"
        },
        "3": {
          "$type": "color",
          "$value": "#2A2A32"
        },
        "500": {
          "$type": "color",
          "$value": "#696963",
          "$description": "Secondary text on light grounds. Darkened from v8's #6E6E68, which measured 4.4990:1 on paper.50 and missed AA by 0.001 — see §9 changelog. Still fails on dark grounds; dark uses ink.700."
        },
        "600": {
          "$type": "color",
          "$value": "#8A8A85"
        },
        "700": {
          "$type": "color",
          "$value": "#9B9B96"
        },
        "900": {
          "$type": "color",
          "$value": "#101012",
          "$description": "v8 Ink. Primary text on light grounds."
        }
      },
      "paper": {
        "0": {
          "$type": "color",
          "$value": "#FFFFFF"
        },
        "50": {
          "$type": "color",
          "$value": "#F1F0EC",
          "$description": "v8 Background. In v9 this doubles as primary text on dark — the palette contains its own inversion."
        },
        "100": {
          "$type": "color",
          "$value": "#EFEEE9"
        },
        "200": {
          "$type": "color",
          "$value": "#DAD8D0"
        }
      },
      "blue": {
        "300": {
          "$type": "color",
          "$value": "#A3ACFF"
        },
        "400": {
          "$type": "color",
          "$value": "#7C89FF",
          "$description": "Lifted blue. Carries text and icons on dark grounds where blue/600 measures 2.35:1."
        },
        "500": {
          "$type": "color",
          "$value": "#2937F0"
        },
        "600": {
          "$type": "color",
          "$value": "#1F2FE3",
          "$description": "v8 Blue. Fill only on dark; also the light-theme action colour."
        },
        "700": {
          "$type": "color",
          "$value": "#1826B8",
          "$description": "v8 Blue Dark. Pressed state."
        },
        "wash-light": {
          "$type": "color",
          "$value": "#E4E7FB"
        },
        "wash-dark": {
          "$type": "color",
          "$value": "#1B1E3A"
        },
        "hair-dark": {
          "$type": "color",
          "$value": "#2A3059"
        }
      },
      "lime": {
        "400": {
          "$type": "color",
          "$value": "#D6F04E"
        },
        "500": {
          "$type": "color",
          "$value": "#CCE83B",
          "$description": "v8 Lime. Clears AA on both grounds unchanged."
        }
      },
      "coral": {
        "500": {
          "$type": "color",
          "$value": "#FF6A46",
          "$description": "v8 Coral. Decorative and status only — never a fill behind interactive text. See §4.3."
        }
      },
      "amber": {
        "ground": {
          "$type": "color",
          "$value": "#1C1A12",
          "$description": "Warm inset for an outstanding task row."
        },
        "hair": {
          "$type": "color",
          "$value": "#3A3520"
        }
      }
