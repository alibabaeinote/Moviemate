rules_version = '2';

// MovieMate — Firestore Security Rules v2
// Reference: docs/MovieMate-Backend-Schema.md §4, docs/MovieMate-Codex-Implementation-Brief.md Phase 1
//
// Core principles (unchanged from v1):
//   1. A user can only reach the pair they belong to (userA or userB).
//   2. commitStatus.userA is writable only by userA, commitStatus.userB only by userB.
//   3. ratings are writable only by their owner.
//   4. filmCache is written only by Cloud Functions; clients read.
//   5. Taste Dial score is enforced to 0..100 at the rule level (never 1..5).
//
// Changes vs the v1 draft shipped with the design docs — see README §"Deviations":
//   a. onlyChangedField() could not actually distinguish commitStatus.userA from
//      commitStatus.userB: affectedKeys() only reports TOP-LEVEL keys, so both edits
//      look like a single "commitStatus" change and either user could commit for both.
//      Replaced with commitsOnlyForSelf(), which pins the *other* user's flag to its
//      previous value.
//   b. The v1 "general member updates" clause on /pairs let any member write any field,
//      including aBothOnboarded and streakCount, which the schema doc requires to be
//      server-owned. Client updates to /pairs are now closed; joining a pair goes
//      through the joinPair callable so the invite code and its expiry are verified
//      server-side.
//   c. /users updates are field-whitelisted rather than blacklisted, so a new
//      server-owned field cannot become client-writable by omission.
//   d. Spark-plan (no Blaze) fallback: createPair/joinPair are Cloud
//      Functions, and 2nd-gen functions require the Blaze plan to deploy at
//      all — not just for their outbound TMDB calls. claimsOwnPair() and
//      joinsOpenSeat() below let a client perform the same two writes those
//      callables' Admin-SDK transactions would, gated tightly enough (only
//      your own empty userB seat on an unexpired invite; only a pair that
//      already, verifiably, lists your own uid) that the result is the same
//      document shape either way. See also /inviteCodes: a new, narrowly
//      scoped collection so a joiner can resolve a shared code to a pairId
//      without first being a member of the pair it points to — cheaper than
//      loosening /pairs' own read rule to cover pre-membership lookups.
//   e. Same no-Blaze fallback, for the daily match: generateDailyMatch and
//      onMatchUpdate are a scheduled function and a Firestore trigger, both
//      Cloud Functions. createsTodaysMatch() lets a pair member write today's
//      match directly (client-computed — see web/match-engine.js — rather
//      than server-verified, an acceptable trust level for a two-person app),
//      gated to once per ~20h. updatesLastMatchGeneratedAt() and
//      advancesStreak() cover the two pair-document side effects that would
//      otherwise only ever happen inside onMatchUpdate. Deliberately NOT
//      touched: matches' own commit/watched fields already had client write
//      paths (commitsOnlyForSelf, confirmsWatchedOnly) from before this app
//      had a server at all, so the mutual-commit and watched-confirmation
//      steps need no new rule surface — only generation and streak do.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function pairData(pairId) {
      return get(/databases/$(database)/documents/pairs/$(pairId)).data;
    }

    function isPairMember(p) {
      return isSignedIn() && (request.auth.uid == p.userA || request.auth.uid == p.userB);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.pairId == null
        && request.resource.data.onboardingComplete == false
        && request.resource.data.ratingCount == 0;

      // Whitelist: everything else (onboardingComplete, ratingCount) is
      // owned by Cloud Functions. 'name' and 'avatarUrl' are self-serve
      // profile edits — see the profile screen — and onUserProfileUpdated
      // copies both onto the shared pair document so the partner can see them.
      //
      // 'pairId' has a second, narrower path (claimsOwnPair, below): the
      // no-Blaze pairing flow (see /pairs' create/update) can't run
      // createPair/joinPair's Admin-SDK transaction, so the client sets its
      // own pairId directly — but only once, and only to a pair that
      // already, verifiably, lists this uid. This is deliberately a
      // fallback for the Spark-plan path, not a replacement for the
      // Cloud-Functions one: either can set this field, and both produce
      // the same document shape.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && (
          changedKeys().hasOnly([
            'name',
            'avatarUrl',
            'fcmTokens',
            'fcmTokenUpdatedAt',
            'notificationSettings',
            'lastActiveAt',
            'timezone'
          ])
          || claimsOwnPair()
        );

      // Account deletion runs through a Cloud Function so the partner's pair is
      // cleaned up too.
      allow delete: if false;
    }

    // ---------- pairs ----------
    match /pairs/{pairId} {
      allow read: if isPairMember(resource.data);

      // Creating a pair: the creator must register themselves as userA, with no
      // partner and no server-owned progress pre-filled. Written directly by
      // the client on the no-Blaze path (see README §"Deviations" — createPair
      // is unavailable without the Blaze plan) as well as by the createPair
      // callable's Admin SDK, which bypasses rules entirely; either way the
      // resulting document has to satisfy this same shape.
      allow create: if isSignedIn()
        && request.resource.data.userA == request.auth.uid
        && request.resource.data.userB == null
        && request.resource.data.aBothOnboarded == false
        && request.resource.data.streakCount == 0
        && request.resource.data.status == 'waiting_partner'
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCodeExpiresAt is timestamp
        && request.resource.data.inviteCodeExpiresAt > request.time;

      // Streaks, aBothOnboarded and lastMatchGeneratedAt stay server-owned —
      // see onRatingComplete / generateDailyMatch — but joining itself has a
      // second path now: joinsOpenSeat() below, the same no-Blaze fallback as
      // /users' claimsOwnPair(). It can only ever claim an empty userB seat on
      // an unexpired invite, writing exactly the fields joinPair's own
      // transaction would.
      allow update: if isSignedIn()
        && (
          joinsOpenSeat()
          || (isPairMember(resource.data) && (updatesLastMatchGeneratedAt() || advancesStreak()))
        );
      allow delete: if false;

      // ---------- pairs/{pairId}/ratings ----------
      // Convention: document id is "{userId}_{filmId}" so a repeat rating is an
      // update rather than a duplicate row (ALI-73 "Duplicate Rating").
      match /ratings/{ratingId} {
        allow read: if isPairMember(pairData(pairId));

        allow create: if isPairMember(pairData(pairId))
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.filmId is string
          && request.resource.data.filmId.size() > 0
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100;

        allow update: if isPairMember(pairData(pairId))
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.filmId is string
          && request.resource.data.filmId.size() > 0
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100;

        allow delete: if false;
      }

      // ---------- pairs/{pairId}/matches ----------
      match /matches/{matchId} {
        allow read: if isPairMember(pairData(pairId));

        // Matches are produced by generateDailyMatch's Admin SDK — or, on the
        // no-Blaze path, by createsTodaysMatch() below.
        allow create: if isSignedIn() && createsTodaysMatch(pairId);

        // A member may flip their own commit flag, or record the manual
        // "we watched it" confirmation. bothConfirmedAt, score, status and
        // attemptNumber stay server-owned.
        //
        // The pair is fetched once and passed down: every get() in a rule is a
        // billed document read, and the previous form issued two per write.
        allow update: if canUpdateMatch(pairId);

        allow delete: if false;
      }

      // ---------- pairs/{pairId}/watchlist ----------
      match /watchlist/{itemId} {
        allow read: if isPairMember(pairData(pairId));

        allow create: if isPairMember(pairData(pairId))
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.status == 'waiting'
          && request.resource.data.watchedAt == null
          && request.resource.data.mutualScore == null;

        // "I'm in too" from inside the list — same self-only commit guarantee as
        // matches. status/mutualScore/watchedAt are set by onCommitUpdate.
        allow update: if canCommitToWatchlistItem(pairId);

        // Either member can remove a film from the shared list.
        allow delete: if isPairMember(pairData(pairId));
      }
    }

    // ---------- inviteCodes ----------
    // A minimal lookup so a joiner can resolve a shared code to a pairId
    // before they're a member of that pair — see isPairMember() above, and
    // deviation (d) at the top of this file. Document id is the invite code
    // itself. This is deliberately permissive on create: it only ever maps a
    // shareable code to a pairId and an expiry, never anything sensitive, and
    // the pair it points at still enforces its own create/update rules
    // regardless of what gets registered here — at worst a stale or
    // fabricated entry points a joiner at a pair whose update then gets
    // rejected because the seat's already taken or the invite's expired.
    match /inviteCodes/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.pairId is string
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;

      allow update, delete: if false;
    }

    // ---------- filmCache ----------
    match /filmCache/{filmId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin SDK bypasses rules, so this means "clients never".
    }

    // ---------- notificationLog (frequency caps) ----------
    // Written by sendNotification; never readable or writable by clients.
    match /notificationLog/{entryId} {
      allow read, write: if false;
    }

    // ---------- Commit helpers ----------

    // Each of these binds the pair document once, so a write costs a single
    // get() rather than one per helper call.
    function canUpdateMatch(pairId) {
      let p = pairData(pairId);
      return isPairMember(p) && (commitsOnlyForSelf(p) || confirmsWatchedOnly());
    }

    function canCommitToWatchlistItem(pairId) {
      let p = pairData(pairId);
      return isPairMember(p) && commitsOnlyForSelf(p);
    }

    // The caller may only raise their OWN commit flag; the partner's flag must be
    // byte-identical to what was already stored. This is what stops one person
    // confirming a mutual commitment on their own (PRD §7.2).
    function commitsOnlyForSelf(p) {
      return changedKeys().hasOnly(['commitStatus'])
        && request.resource.data.commitStatus.userA is bool
        && request.resource.data.commitStatus.userB is bool
        && (
          (
            request.auth.uid == p.userA &&
            request.resource.data.commitStatus.userB == resource.data.commitStatus.userB
          ) || (
            request.auth.uid == p.userB &&
            request.resource.data.commitStatus.userA == resource.data.commitStatus.userA
          )
        );
    }

    // Manual "We watched it" — explicitly manual, never inferred (PRD §10).
    //
    // The `is timestamp` guard is defensive: it makes the type explicit before
    // the comparison rather than relying on the comparison to reject a
    // non-timestamp.
    //
    // KNOWN, UNEXPLAINED: the emulator logs "evaluation error at <this rule>"
    // alongside a correct `false` on every DENIED update to a match. Both a
    // single-get() refactor and this type guard were tried and neither removed
    // it. It is not a correctness problem — rules deny on an evaluation error,
    // and rules-tests/ proves every allow and deny behaves as intended — but it
    // means a genuine rule error here would hide in the noise. Worth another
    // look before launch.
    function confirmsWatchedOnly() {
      return changedKeys().hasOnly(['watchedConfirmedAt', 'watchedConfirmedBy'])
        && resource.data.watchedConfirmedAt == null
        // A no-match day ('dismissed', filmId == "") has nothing to watch —
        // block confirming one, even though nothing in the UI offers to.
        && resource.data.filmId is string
        && resource.data.filmId.size() > 0
        && request.resource.data.watchedConfirmedAt is timestamp
        && request.resource.data.watchedConfirmedAt == request.time
        && request.resource.data.watchedConfirmedBy == request.auth.uid;
    }

    // ---------- No-Blaze fallback helpers (deviation d, above) ----------

    // Lets a client set its own users/{uid}.pairId directly, exactly once,
    // and only to a pair that already, verifiably, lists this uid as userA
    // or userB — so this can only ever finish a create/join the client
    // itself just performed (createPair's own pairs/create write, or a
    // joinsOpenSeat() update below), never attach to an arbitrary pair.
    // Mirrors the pairId + timezone + updatedAt write createPair/joinPair's
    // Admin-SDK transaction makes, minus timezone/updatedAt — a self-serve
    // 'timezone' edit is already whitelisted above, on its own, if needed.
    function claimsOwnPair() {
      let p = pairData(request.resource.data.pairId);
      return changedKeys().hasOnly(['pairId'])
        && resource.data.pairId == null
        && request.resource.data.pairId is string
        && (p.userA == request.auth.uid || p.userB == request.auth.uid);
    }

    // Claims an empty userB seat on an unexpired invite, writing exactly the
    // fields joinPair's own transaction would (see
    // functions/src/callable/joinPair.ts) so a pair document reads the same
    // whether it was joined through the callable or this fallback.
    function joinsOpenSeat() {
      return changedKeys().hasOnly(['userB', 'status', 'joinedAt', 'userBName', 'userBAvatarUrl'])
        && resource.data.userB == null
        && resource.data.status == 'waiting_partner'
        && resource.data.inviteCodeExpiresAt > request.time
        && request.resource.data.userB == request.auth.uid
        && request.resource.data.userB != resource.data.userA
        && request.resource.data.status == 'both_rating'
        && request.resource.data.joinedAt is timestamp
        && request.resource.data.joinedAt == request.time
        && request.resource.data.userBName is string
        && (request.resource.data.userBAvatarUrl is string || request.resource.data.userBAvatarUrl == null);
    }

    // No-Blaze fallback for generateDailyMatch: a pair member may write
    // today's match directly, once the pair has gone quiet for a while.
    // 20h rather than "a new local day" — the real per-timezone 9am rule
    // needs a scheduled function to evaluate hourly; this is the closest a
    // security rule (no clock of its own beyond request.time) can get
    // without one. The score/reason values themselves are trusted from the
    // client (web/match-engine.js runs the same algorithm as
    // domain/scoring.ts, minus the country signal — see deviation e above)
    // rather than recomputed here, the same trust level createPair/joinPair's
    // fallback already accepts for a two-person app.
    function createsTodaysMatch(pairId) {
      let p = pairData(pairId);
      return isPairMember(p)
        && (p.lastMatchGeneratedAt == null || p.lastMatchGeneratedAt < request.time - duration.value(20, 'h'))
        && request.resource.data.filmId is string
        && request.resource.data.reason is string
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && request.resource.data.status in ['suggested', 'dismissed']
        && request.resource.data.attemptNumber == 1
        && request.resource.data.suggestedAt is timestamp
        && request.resource.data.suggestedAt == request.time
        && request.resource.data.commitStatus.userA == false
        && request.resource.data.commitStatus.userB == false
        && request.resource.data.bothConfirmedAt == null
        && request.resource.data.watchedConfirmedAt == null
        && request.resource.data.watchedConfirmedBy == null;
    }

    // The other half of createsTodaysMatch: the client stamps this on the
    // /pairs doc in the same batch as the match create, so the 20h gate
    // above has something to check next time.
    function updatesLastMatchGeneratedAt() {
      return changedKeys().hasOnly(['lastMatchGeneratedAt'])
        && request.resource.data.lastMatchGeneratedAt is timestamp
        && request.resource.data.lastMatchGeneratedAt == request.time;
    }

    // No-Blaze fallback for onMatchUpdate's updateStreak: whoever just
    // confirmed "we watched it" (already permitted by confirmsWatchedOnly,
    // unchanged) follows up with this write, having run domain/streak.ts's
    // same pure advanceStreak() logic client-side. Pinned to a step of
    // exactly +1 or a reset to 1 so a client cannot simply declare a
    // streak of 999.
    function advancesStreak() {
      return changedKeys().hasOnly(['streakCount', 'lastWatchAt'])
        && request.resource.data.lastWatchAt is timestamp
        && (
          request.resource.data.streakCount == resource.data.streakCount + 1
          || request.resource.data.streakCount == 1
        );
    }
  }
}
